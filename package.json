{
  "name": "totvibe-ocr",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare": "test -n \"$CI\" || uv run lefthook install",
    "knip": "pnpm run build && knip",
    "format": "prettier --write .",
    "typecheck": "pnpm run build && tsc -b",
    "cz": "node scripts/run-cz.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "pnpm -r --if-present run build",
    "test": "vitest run"
  },
  "devDependencies": {
    "@totvibe/tsconfig": "workspace:*",
    "@zyplux/cz": "catalog:",
    "@zyplux/eslint-config": "catalog:",
    "eslint": "catalog:",
    "knip": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "vitest": "catalog:",
    "@types/node": "catalog:"
  },
  "packageManager": "pnpm@12.15.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.12.1",
      "onFail": "download"
    }
  }
}
